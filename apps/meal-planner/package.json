    "fonts": "python3 scripts/subset-fonts.py"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
